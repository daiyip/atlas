cavalry"],"result":"won"},{"name":"Northern Han","name_zh":"北汉军","commanders":[{"name":"Liu Min","name_zh":"刘旻"}],"troops":30000,"troops_text":"c. 30,000","troops_text_zh":"约3万","units":["infantry","cavalry"],"result":"lost"},{"name":"Liao","name_zh":"辽军","commanders":[{"name":"Yang Gun","name_zh":"杨衮"}],"troops":10000,"troops_text":"over 10,000 cavalry","troops_text_zh":"骑兵万余","units":["cavalry"],"result":"lost"}],"note":"Part of the Zhou right wing fled, but Chai Rong led the charge himself; the Liao horsemen stayed out of the fighting.","note_zh":"后周右翼一度溃逃，柴荣亲自督战冲锋；辽军骑兵按兵未动。"},"huainan-campaign":{"sides":[{"name":"Later Zhou","name_zh":"后周军","commanders":[{"name":"Chai Rong","name_zh":"柴荣"},{"name":"Zhao Kuangyin","name_zh":"赵匡胤"},{"name":"Li Chongjin","name_zh":"李重进"}],"troops":null,"troops_text":"unknown","troops_text_zh":"不详","units":["infantry","cavalry","navy","siege"],"result":"won"},{"name":"Southern Tang","name_zh":"南唐军","commanders":[{"name":"Liu Renshan","name_zh":"刘仁赡"}],"troops":null,"troops_text":"unknown","troops_text_zh":"不详","units":["infantry","navy"],"result":"lost"}],"note":"Liu Renshan held Shouzhou for over a year.","note_zh":"刘仁赡坚守寿州一年多。","losses":"Southern Tang lost 14 prefectures north of the Yangtze","losses_zh":"南唐失去江北十四州"},"shizong-northern-campaign":{"sides":[{"name":"Later Zhou","name_zh":"后周军","commanders":[{"name":"Chai Rong","name_zh":"柴荣"},{"name":"Zhao Kuangyin","name_zh":"赵匡胤"},{"name":"Han Lingkun","name_zh":"韩令坤"}],"troops":null,"troops_text":"unknown","troops_text_zh":"不详","units":["infantry","cavalry","navy"],"result":"won"},{"name":"Liao","name_zh":"辽","commanders":[],"troops":null,"troops_text":"unknown","troops_text_zh":"不详","units":["cavalry"],"result":"lost"}],"note":"Most Liao-held towns surrendered without a fight.","note_zh":"辽军据守的城池大多不战而降。"}},"routes":[{"id":"later-tang-takes-kaifeng","kind":"campaign","name":"Li Cunxu's dash to Kaifeng","name_zh":"李存勖奔袭汴州灭梁","from":923,"to":923,"event":"later-tang","side":"Later Tang","path":[[115.15,36.28],[116.47,35.91],[116.5,35.73],[115.45,35.25],[114.35,34.79]],"summary":"Li Cunxu crossed the Yellow River at Yunzhou, beat the Liang army at Zhongdu and rode to Kaifeng, ending the Later Liang.","summary_zh":"李存勖从郓州渡河，在中都击败梁军，直取汴州，后梁灭亡。"},{"id":"later-tang-conquers-shu","kind":"campaign","name":"Later Tang conquers Former Shu","name_zh":"后唐伐蜀","from":925,"to":925,"event":"shu-conquered","side":"Later Tang","path":[[112.45,34.62],[108.94,34.26],[107.39,34.52],[106.97,34.24],[106.65,33.9],[106.15,33.33],[105.84,32.44],[105.55,32.2],[104.73,31.47],[104.07,30.67]],"summary":"The army went west via Fengxiang, crossed the Qinling at Dasan Pass, passed Jianmen and reached Chengdu in about seventy days.","summary_zh":"大军经凤翔，过大散关越秦岭，穿过剑门，约七十天抵达成都。"},{"id":"khitan-conquest-of-balhae","kind":"campaign","name":"Khitan conquest of Balhae","name_zh":"契丹灭渤海","from":925,"to":926,"event":"balhae-falls","side":"Khitans","path":[[119.39,43.98],[122.26,43.62],[125.18,44.43],[129.2,44.0]],"summary":"Abaoji marched east from his capital, took Fuyu, then besieged the Balhae capital, which surrendered.","summary_zh":"阿保机从上京东征，攻下扶余城，又围攻渤海都城，渤海王出降。"},{"id":"bach-dang-fleet","kind":"campaign","name":"Southern Han fleet to Bạch Đằng","name_zh":"南汉水军攻交州","from":938,"to":938,"event":"bach-dang","side":"Southern Han","path":[[113.26,23.13],[111.98,21.86],[110.36,21.27],[109.2,21.66],[106.75,20.9]],"summary":"A Southern Han fleet sailed along the coast toward Jiaozhou and was trapped on stakes in the Bạch Đằng River.","summary_zh":"南汉水军沿海岸驶向交州，在白藤江被木桩阵困住。"},{"id":"khitan-invades-later-jin","kind":"campaign","name":"Khitan march on Kaifeng","name_zh":"契丹南下灭后晋","from":946,"to":947,"event":"liao-takes-kaifeng","side":"Khitans","path":[[119.39,43.98],[116.4,39.9],[115.46,38.87],[114.57,38.15],[114.39,36.1],[114.35,34.79]],"summary":"Yelü Deguang rode south from Youzhou, took the surrender of the main Jin army near Zhending and entered Kaifeng.","summary_zh":"耶律德光从幽州南下，在恒州一带迫降